# Extract only pure format validation, not the browser execution runtime.
# Generated playback-input-schema.js inputs: cutscene-runtime.js and cutscene-dialogue.js.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/../cutscene-runtime.js" runtime_schema_source)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/../cutscene-dialogue.js" dialogue_schema_source)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/../cutscene-runtime.js"
    "${CMAKE_CURRENT_SOURCE_DIR}/../cutscene-dialogue.js")
function(schema_extract variable first last)
    string(FIND "${${variable}}" "${first}" begin)
    string(FIND "${${variable}}" "${last}" end)
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Playback schema source boundaries changed: ${first}")
    endif()
    math(EXPR size "${end} - ${begin}")
    string(SUBSTRING "${${variable}}" ${begin} ${size} fragment)
    set(playback_schema "${playback_schema}\n${fragment}" PARENT_SCOPE)
endfunction()
set(playback_schema "// Generated by native/rebuild/playback-schema.cmake from browser format validators.\nvar OB64={cutsceneDialogue:{}}; var M={cloneJson:function(v){return JSON.parse(JSON.stringify(v));}}; function fail(message){throw new Error(message);} function boundary(message){throw new Error(message);}")
schema_extract(dialogue_schema_source "  function validateHelper(" "  function Machine(")
schema_extract(runtime_schema_source "  function externalEventCount(" "  // Lossless 48-byte")
schema_extract(runtime_schema_source "  var NATIVE_POSE_WIDTHS" "  function launchTranslationIndex(")
string(APPEND playback_schema "\nOB64.cutsceneDialogue.validateHelper=validateHelper;\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/playback-input-schema.js" "${playback_schema}")
