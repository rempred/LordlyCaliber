       howto = elf_mips_howto_table + r_type;
 
       r_symndx = ELF32_R_SYM (rel->r_info);
+      rello = mips_elf_associated_lo16 (rel, relend);
 
       /* Mix in the change in GP address for a GP relative reloc.  */
       if (r_type != R_MIPS_GPREL16
