 	      contents + relhi->r_offset);
 }
 
+/* Find the LO16 relocation associated with a HI16 relocation.  GNU 2.6
+   normally accepts only an immediately adjacent pair.  KMC GCC may place
+   another relocation between a symbolic HI16 and its LO16.  The opt-in OB64
+   mode searches forward for the first LO16 against the same symbol while
+   leaving the historical GNU 2.6 rule unchanged for every other build.  */
+
+static Elf_Internal_Rela *
+mips_elf_associated_lo16 (rel, relend)
+     Elf_Internal_Rela *rel;
+     Elf_Internal_Rela *relend;
+{
+#ifdef OB64_SYMBOL_MATCHED_HI16_LO16
+  unsigned long r_symndx;
+#endif
+
+  if (ELF32_R_TYPE (rel->r_info) != R_MIPS_HI16)
+    return NULL;
+
+#ifdef OB64_SYMBOL_MATCHED_HI16_LO16
+  r_symndx = ELF32_R_SYM (rel->r_info);
+  for (++rel; rel < relend; rel++)
+    if (ELF32_R_TYPE (rel->r_info) == R_MIPS_LO16
+	&& ELF32_R_SYM (rel->r_info) == r_symndx)
+      return rel;
+  return NULL;
+#else
+  ++rel;
+  if (rel < relend && ELF32_R_TYPE (rel->r_info) == R_MIPS_LO16)
+    return rel;
+  return NULL;
+#endif
+}
+
 /* Relocate a MIPS ELF section.  */
 
 static boolean
